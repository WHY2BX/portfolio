# Resend API Key for the Contact Ticket form
RESEND_API_KEY=your_resend_api_key_here

# Target email to receive inquiries from the contact form
CONTACT_EMAIL=your_email@example.com

# Discord User ID for the real-time Discord presence card (Lanyard API)
DISCORD_USER_ID=your_discord_id_here
NEXT_PUBLIC_DISCORD_ID=your_discord_id_here
